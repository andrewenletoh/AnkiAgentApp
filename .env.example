# Copy this file to .env and fill in your own values.
# .env is gitignored, so your settings never get committed.
#
# This project does not ship with, or connect to, any specific AWS account.
# You must have your own AWS account with Amazon Bedrock access enabled for
# the model you choose below, and standard AWS credentials configured on
# your machine (e.g. via `aws configure`, an AWS_PROFILE, or an IAM role).
# All Bedrock usage is billed to whichever AWS credentials are active where
# you run this app.

# AWS region where you have Bedrock model access enabled.
AWS_REGION=us-west-2

# The Bedrock model ID to use. Must be a model you have access to in the
# region above (see the AWS Bedrock console > Model access).
BEDROCK_MODEL_ID=global.amazon.nova-2-lite-v1:0
